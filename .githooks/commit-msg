#!/usr/bin/env bash
set -u

message_file="$1"
first_line="$(head -n 1 "$message_file")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if [[ "$first_line" =~ $pattern ]]; then
  printf 'true\n'
  exit 0
fi

printf 'false\n'
printf 'Use Conventional Commits, for example: feat: add compaction policy\n'
exit 1
